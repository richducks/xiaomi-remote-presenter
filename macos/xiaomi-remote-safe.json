{
  "title": "Xiaomi Remote 2 Pro SAFE · 浏览器标签页（默认）",
  "rules": [
    {
      "description": "Xiaomi Remote 2 Pro SAFE · 小房子新建标签页 Cmd+T",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "home",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Safari$",
                "^org\\.mozilla\\.firefox$",
                "^org\\.mozilla\\.firefoxdeveloperedition$",
                "^org\\.mozilla\\.nightly$",
                "^com\\.google\\.Chrome(?:\\.beta|\\.dev|\\.canary)?$",
                "^com\\.microsoft\\.edgemac(?:\\.Beta|\\.Dev|\\.Canary)?$",
                "^com\\.brave\\.Browser(?:\\.beta|\\.nightly)?$",
                "^com\\.operasoftware\\.Opera(?:Next)?$",
                "^com\\.vivaldi\\.Vivaldi$",
                "^org\\.chromium\\.Chromium$",
                "^org\\.torproject\\.TorBrowser$",
                "^org\\.mozilla\\.librewolf$"
              ]
            }
          ],
          "to": [
            {
              "key_code": "t",
              "repeat": false,
              "modifiers": [
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
