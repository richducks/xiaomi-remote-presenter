{
  "title": "Xiaomi Remote 2 Pro Presenter",
  "rules": [
    {
      "description": "Xiaomi OK -> F5 in WPS Presentation",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "f5"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.kingsoft\\.wpsoffice\\.mac\\.global$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Xiaomi OK -> start from beginning in Microsoft PowerPoint",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.microsoft\\.(Powerpoint|PowerPoint|powerpoint)$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Xiaomi OK -> play in Keynote",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "p",
              "modifiers": [
                "left_command",
                "left_option"
              ]
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.iWork\\.Keynote$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Xiaomi Back -> Esc in presentation apps",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "consumer_key_code": "ac_back"
          },
          "to": [
            {
              "key_code": "escape"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.kingsoft\\.wpsoffice\\.mac\\.global$",
                "^com\\.microsoft\\.(Powerpoint|PowerPoint|powerpoint)$",
                "^com\\.apple\\.iWork\\.Keynote$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Block Xiaomi physical F5",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f5",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
