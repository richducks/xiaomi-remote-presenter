{
  "title": "Xiaomi Remote 2 Pro · 浏览器 / 演示 (设备专属)",
  "rules": [
    {
      "description": "WPS: OK 开始演示",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 10007,
                  "product_id": 12984
                }
              ]
            },
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.kingsoft\\.wpsoffice\\.mac\\.global$"
              ]
            }
          ],
          "to": [
            {
              "key_code": "f5",
              "repeat": false
            }
          ]
        }
      ]
    },
    {
      "description": "PowerPoint: OK 从头放映",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
